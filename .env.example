[TEMPLATE]
# DATABASE_URL: direct Postgres connection to your Supabase project
# (Supabase dashboard → Project Settings → Database → Connection string → "URI",
#  use the non-pooling / direct connection on port 5432, or the pooler on 6543).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Least-privilege runtime connection (recommended for production).
# Migration 0026 creates the `app_user` role with DML-only privileges (no DDL,
# no role management). After applying it, set a password once via SQL:
#   alter role app_user password 'a-strong-random-password';
# then point the app here. DATABASE_URL above stays the owner/migration URL.
# When APP_DATABASE_URL is set, the app uses it and ignores DATABASE_URL for
# queries (scripts/migrate.ts always uses DATABASE_URL).
# APP_DATABASE_URL=postgresql://app_user:[PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Keep this "false" for now — it only flips on once SupabaseCrmRepository (Phase 2B,
# real Supabase Auth) is implemented. Until then, the app talks to the same Supabase
# Postgres directly via `pg`, which is why DATABASE_URL above already points at Supabase.
SUPABASE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-only, NEVER prefix with NEXT_PUBLIC_, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 5: AI chatbot (server-only secret) ---
# OpenAI API key for the /api/chat edge route. Without this, the chatbot
# returns a graceful fallback message. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Phase 5: Analytics (public, safe to expose) ---
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable GA.
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID. Leave empty to disable Clarity.
NEXT_PUBLIC_CLARITY_ID=

# --- Phase 2B: auth dev fallback ---
# Set to "1" to enable dev-only auth bypass (student/admin demo login).
# OFF by default — you must opt in explicitly. Do NOT set this in production.
# DEV_AUTH_ENABLED=1

# --- Session cookie signing (dev-auth) ---
# HMAC secret used to sign the dev-auth session cookies (admin_session /
# student_session) so a forged/unsigned cookie is rejected. Generate a strong
# random value in production: `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Student Google OAuth (Phase: Social Auth) ---
# Enable the Google provider in Supabase Dashboard → Auth → Providers.
# Add http://localhost:3000/auth/callback and https://<domain>/auth/callback
# to the Supabase "Redirect URLs" allowlist.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin provisioning ---
# First Gmail that signs in via /admin/login gets the admin role automatically.
INITIAL_ADMIN_EMAIL=your@email.com

# --- Rate limiting ---
# Set to "1" when the app runs behind a trusted reverse proxy (Vercel, nginx)
# so the rate limiter trusts the client IP from x-forwarded-for. Leave unset
# when exposed directly — the header is client-spoofable.
# TRUST_PROXY=1

# --- Rate limiter store (H1) ---
# When set, rate limits are enforced in Upstash Redis (shared across all
# serverless instances). Without these, the limiter falls back to an in-memory
# sliding window — fine locally, but per-instance on Vercel. Get keys at
# https://console.upstash.com (create a Redis database, REST section).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# --- Observability (QA-1) ---
# Structured JSON logging is always on (serverless log drain parseable). For
# full APM/error tracking, set the Sentry DSN — the seam exists so enabling it
# later is a config flip, not a refactor. Get one at https://sentry.io (Next.js project).
# NEXT_PUBLIC_SENTRY_DSN=

# --- DB connection pool tuning ---
# Max connections per serverless/build process. Keep small on Supabase poolers.
# Defaults: 1 during `next build`, 2 at runtime.
# PGPOOL_MAX=2

# --- Next build tuning ---
# Supabase session poolers can reject highly parallel static generation with
# EMAXCONNSESSION. Keep this low for Vercel builds that read DATABASE_URL.
# NEXT_STATIC_GENERATION_MAX_CONCURRENCY=1
# NEXT_STATIC_GENERATION_MIN_PAGES_PER_WORKER=25

# --- Backups (BE-4 / QA-3) ---
# Used by the nightly .github/workflows/backup.yml pg_dump cron. A connection
# string with SELECT grants is enough (does not need superuser). Keep secret.
# BACKUP_DATABASE_URL=
